{
  "name": "pi-desktop",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "A desktop workspace for your own Pi agent — no fork, no reduced toolset.",
  "author": {
    "name": "GuoGan",
    "email": "163803821+HandsomeGanzige@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist/app/main/bootstrap.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build --config vite.preload.config.ts && vite build",
    "lint": "eslint .",
    "format:check": "node scripts/check-format.mjs",
    "format:write": "node scripts/check-format.mjs --write",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test:browser": "npm run build && node scripts/smoke-browser.mjs",
    "test:pi": "npm run build && node scripts/smoke-pi.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "package": "npm run verify && electron-builder --dir",
    "dist": "npm run verify && electron-builder",
    "test:lifecycle": "npm run build && node scripts/smoke-lifecycle.mjs",
    "test:lifecycle:stress": "npm run build && node scripts/smoke-lifecycle.mjs --repeat=10",
    "dev:components": "vite --config tests/component-preview/vite.config.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "check:protected": "node scripts/check-protected.ts",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test:ipc": "npm run build && node scripts/smoke-ipc.mjs",
    "verify:baseline": "npm run check:protected && npm run check:boundaries && npm run lint && npm run format:check && npm run typecheck && npm run typecheck:tests && npm test && npm run build",
    "verify": "npm run verify:baseline && node scripts/smoke-ipc.mjs && node scripts/smoke-lifecycle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@gsap/react": "^2.1.2",
    "@pierre/diffs": "1.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.42.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.13",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.2.0",
    "electron-builder": "26.17.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.pi.desktop",
    "productName": "Pi Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "src/renderer/ui/SHADCN-LICENSE.txt"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
